// Copied to calamares-vm.kdl by the live-ISO autostart line, only inside a VM.
// Not read by niri directly (no .kdl extension).
//
// Calamares: float, 1024 wide and 85% of the screen high. It runs on XWayland (xcb), and
// xwayland-satellite can keep a stale X screen size after the display resizes (seen in a QEMU
// VM: 1698x952 on a 1920x1080 output). A full-height tiled installer then reaches past the X
// screen and its Next button ignores clicks. Height is a proportion, not a fixed 900: a fixed
// 900 ran off an 800-px-high VM screen and hid the buttons (QEMU 1280x800, 2026-10-16).
window-rule {
    match app-id="^calamares$"
    open-floating true
    default-column-width { fixed 1024; }
    default-window-height { proportion 0.85; }
}
