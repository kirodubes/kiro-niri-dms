// Copied to calamares-vm.kdl by the live-ISO autostart line, only inside a VM.
// Not read by niri directly (no .kdl extension).
//
// Calamares: float at 1024x900. It runs on XWayland (xcb), and xwayland-satellite can
// keep a stale X screen size after the display resizes (seen in a QEMU VM: 1698x952 on
// a 1920x1080 output). A full-height tiled installer then reaches past the X screen and
// its Next button ignores clicks.
window-rule {
    match app-id="^calamares$"
    open-floating true
    default-column-width { fixed 1024; }
    default-window-height { fixed 900; }
}
